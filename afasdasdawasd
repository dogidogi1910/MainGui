    label.Text = name
    label.TextColor3 = Color3.fromRGB(215, 215, 225)
    label.Font = Enum.Font.Gotham
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left

    local btn = Instance.new("TextButton")
    btn.Parent = frame
    btn.Size = UDim2.new(0, 38, 0, 22)
    btn.Position = UDim2.new(0.55, 0, 0.5, -11)
    btn.BackgroundColor3 = default and Color3.fromRGB(70, 200, 70) or Color3.fromRGB(50, 50, 60)
    btn.Text = default and "ON" or "OFF"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 10
    btn.BorderSizePixel = 0

    local btnCorner = Instance.new("UICorner")
    btnCorner.Parent = btn
    btnCorner.CornerRadius = UDim.new(0, 3)

    -- Кнопка для бинда
    local bindBtn = Instance.new("TextButton")
    bindBtn.Parent = frame
    bindBtn.Size = UDim2.new(0, 55, 0, 22)
    bindBtn.Position = UDim2.new(0.8, 0, 0.5, -11)
    bindBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    bindBtn.Text = "Bind"
    bindBtn.TextColor3 = Color3.fromRGB(200, 200, 210)
    bindBtn.Font = Enum.Font.GothamBold
    bindBtn.TextSize = 10
    bindBtn.BorderSizePixel = 0

    local bindCorner = Instance.new("UICorner")
    bindCorner.Parent = bindBtn
    bindCorner.CornerRadius = UDim.new(0, 3)

    local state = default
    local isBinding = false

    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.BackgroundColor3 = state and Color3.fromRGB(70, 200, 70) or Color3.fromRGB(50, 50, 60)
        btn.Text = state and "ON" or "OFF"
        _G.COMBAT[key] = state
        
        if key == "noRecoil" then
            if state then enableNoRecoil() else disableNoRecoil() end
        end
        if key == "noSpread" then
            if state then enableNoSpread() else disableNoSpread() end
        end
        if key == "instantReload" then
            if state then enableInstantReload() else disableInstantReload() end
        end
    end)

    bindBtn.MouseButton1Click:Connect(function()
        if isBinding then return end
        isBinding = true
        bindBtn.Text = "..."
        bindBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        
        local connection
        connection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                _G.BINDS[key] = input.KeyCode
                bindBtn.Text = input.KeyCode.Name
                bindBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
                isBinding = false
                connection:Disconnect()
                print("✅ " .. name .. " привязан к " .. input.KeyCode.Name)
            end
        end)
        
        task.delay(5, function()
            if isBinding then
                isBinding = false
                bindBtn.Text = "Bind"
                bindBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
                if connection then connection:Disconnect() end
            end
        end)
    end)

    -- Устанавливаем текущий бинд если есть
    if _G.BINDS[key] then
        bindBtn.Text = _G.BINDS[key].Name
    end

    return frame
end

