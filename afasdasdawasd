-- ===== 3. ЛОГИКА ESP (ИЗ РАБОЧЕГО СКРИПТА) =====
local function applyESP(part)
    if part.Name == "Head" and part:IsA("BasePart") then
        local char = part.Parent
        if not char:FindFirstChildOfClass("Humanoid") then return end
        if char == player.Character then return end
        
        local isSleeper = char.Name:lower():find("sleeper") or char:FindFirstChild("Sleeper")
        
        -- BillboardGui
        local bgui = Instance.new("BillboardGui")
        bgui.Parent = part
        bgui.AlwaysOnTop = true
        bgui.Size = UDim2.new(0, 200, 0, 60)
        bgui.Adornee = part
        
        local label = Instance.new("TextLabel")
        label.Parent = bgui
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.new(1, 1, 1)
        label.TextStrokeTransparency = 0.5
        label.TextSize = 14
        label.Font = Enum.Font.GothamSemibold
        label.TextXAlignment = Enum.TextXAlignment.Center
        label.TextYAlignment = Enum.TextYAlignment.Center
        
        -- Highlight (подсветка)
        local highlight = Instance.new("Highlight")
        highlight.Parent = char
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 0.7
        highlight.OutlineTransparency = 0.3
        
        local connection
        connection = RunService.Heartbeat:Connect(function()
            if not char.Parent then
                bgui:Destroy()
                highlight:Destroy()
                connection:Disconnect()
                return
            end
            
            local dist = math.floor((part.Position - Camera.CFrame.Position).Magnitude)
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hp = hum and math.floor(hum.Health) or 0
            local maxHp = hum and math.floor(hum.MaxHealth) or 0
            
            local show = false
            
            if _G.ESP.enabled then
                if isSleeper and _G.ESP.sleepers then
                    show = true
                    local text = "SLEEPER"
                    if _G.ESP.health then text = text .. "\n[HP: " .. hp .. "/" .. maxHp .. "]" end
                    if _G.ESP.distance then text = text .. " [" .. dist .. "m]"
                    label.Text = text
                    highlight.FillColor = Color3.fromRGB(150, 150, 150)
                    highlight.OutlineColor = Color3.fromRGB(100, 100, 100)
                elseif not isSleeper and _G.ESP.players then
                    show = true
                    local text = ""
                    if _G.ESP.name then text = char.Name end
                    if _G.ESP.health then 
                        if text ~= "" then text = text .. "\n" end
                        text = text .. "[HP: " .. hp .. "/" .. maxHp .. "]"
                    end
                    if _G.ESP.distance then 
                        if text ~= "" then text = text .. " " end
                        text = text .. "[" .. dist .. "m]"
                    end
                    label.Text = text
                    highlight.FillColor = Color3.fromRGB(255, 85, 85)
                    highlight.OutlineColor = Color3.fromRGB(200, 50, 50)
                end
            end
            
            bgui.Enabled = show
            highlight.Enabled = show
            
            -- Бокс (если включен)
            if _G.ESP.box and show then
                -- Можно добавить бокс через Frame, но BillboardGui уже есть
                -- Просто оставляем как есть
            end
        end)
    end
end

