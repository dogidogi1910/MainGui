    sliderBg.Parent = frame
    sliderBg.Size = UDim2.new(0.6, 0, 0, 4)
    sliderBg.Position = UDim2.new(0.02, 0, 0.7, 0)
    sliderBg.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    sliderBg.BorderSizePixel = 0

    local sliderCorner = Instance.new("UICorner")
    sliderCorner.Parent = sliderBg
    sliderCorner.CornerRadius = UDim.new(0, 8)

    local sliderFill = Instance.new("Frame")
    sliderFill.Parent = sliderBg
    sliderFill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    sliderFill.BackgroundColor3 = Color3.fromRGB(100, 180, 255)
    sliderFill.BorderSizePixel = 0

    local fillCorner = Instance.new("UICorner")
    fillCorner.Parent = sliderFill
    fillCorner.CornerRadius = UDim.new(0, 8)

    local sliderThumb = Instance.new("Frame")
    sliderThumb.Parent = sliderBg
    sliderThumb.Size = UDim2.new(0, 12, 0, 12)
    sliderThumb.Position = UDim2.new((default - min) / (max - min), -6, 0.5, -6)
    sliderThumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    sliderThumb.BorderSizePixel = 0

    local thumbCorner = Instance.new("UICorner")
    thumbCorner.Parent = sliderThumb
    thumbCorner.CornerRadius = UDim.new(0, 6)

    local val = default

    sliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local relX = input.Position.X - sliderBg.AbsolutePosition.X
            local percent = math.clamp(relX / sliderBg.AbsoluteSize.X, 0, 1)
            val = math.floor(min + (max - min) * percent)
            valueLabel.Text = tostring(val)
            sliderFill.Size = UDim2.new(percent, 0, 1, 0)
            sliderThumb.Position = UDim2.new(percent, -6, 0.5, -6)
            _G.COMBAT[key] = val
            if key == "fov" then updateFOVSize() end
            if callback then callback(val) end
        end
    end)

    local dragging = false
    sliderThumb.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
        end
    end)

    sliderThumb.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end

        local relX = input.Position.X - sliderBg.AbsolutePosition.X
        local percent = math.clamp(relX / sliderBg.AbsoluteSize.X, 0, 1)
        val = math.floor(min + (max - min) * percent)
        valueLabel.Text = tostring(val)
        sliderFill.Size = UDim2.new(percent, 0, 1, 0)
        sliderThumb.Position = UDim2.new(percent, -6, 0.5, -6)
        _G.COMBAT[key] = val
        if key == "fov" then updateFOVSize() end
        if callback then callback(val) end
    end)

    return frame
end

