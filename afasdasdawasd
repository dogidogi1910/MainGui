local RecoilFunction = nil
local RecoilHook = nil

local function setupNoRecoil()
    for i, v in pairs(getgc(true)) do
        if type(v) == "function" and debug.getinfo(v)["name"] == "Add" then
            local src = debug.getinfo(v)["short_src"]
            if src and src:find("Recoil") then
                RecoilFunction = v
                break
            end
        end
    end
    if RecoilFunction then
        print("✅ No Recoil: функция найдена")
        return true
    else
        warn("⚠️ No Recoil: функция не найдена")
        return false
    end
end

local function enableNoRecoil()
    if not RecoilFunction then
        if not setupNoRecoil() then return false end
    end
    if not RecoilHook then
        RecoilHook = hookfunction(RecoilFunction, function(...)
            local args = {...}
            args[1] = 0
            args[4] = 0
            return RecoilHook(table.unpack(args))
        end)
    end
    print("✅ No Recoil: включен")
    return true
end

local function disableNoRecoil()
    if RecoilHook and RecoilFunction then
        hookfunction(RecoilFunction, RecoilHook)
        RecoilHook = nil
    end
    print("❌ No Recoil: выключен")
end

setupNoRecoil()
task.delay(5, function()
    if not RecoilFunction then setupNoRecoil() end
end)

-- ===== 3. NO SPREAD =====
local SpreadFunction = nil
local SpreadHook = nil

local function setupNoSpread()
    for i, v in pairs(getgc(true)) do
        if type(v) == "function" then
            local info = debug.getinfo(v)
            if info and info.name then
                local name = info.name:lower()
                if name:find("spread") or name:find("accuracy") or name:find("bloom") or name:find("inaccuracy") then
                    local src = info.short_src or ""
                    if not src:find("FoxMenu") and not src:find("loadstring") then
                        SpreadFunction = v
                        print("✅ No Spread: найдена функция:", info.name)
                        break
                    end
                end
            end
        end
    end
    if SpreadFunction then
        return true
    else
        warn("⚠️ No Spread: функция не найдена")
        return false
    end
end

local function enableNoSpread()
    if not SpreadFunction then
        if not setupNoSpread() then return false end
    end
    if not SpreadHook then
        SpreadHook = hookfunction(SpreadFunction, function(...)
            local args = {...}
            for i = 1, #args do
                if type(args[i]) == "number" then
                    args[i] = 0
                end
            end
            return SpreadHook(table.unpack(args))
        end)
    end
    print("✅ No Spread: включен")
    return true
end

local function disableNoSpread()
    if SpreadHook and SpreadFunction then
        hookfunction(SpreadFunction, SpreadHook)
        SpreadHook = nil
    end
    print("❌ No Spread: выключен")
end

setupNoSpread()
task.delay(5, function()
    if not SpreadFunction then setupNoSpread() end
end)

