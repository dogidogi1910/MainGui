-- Функция создания подтоггла с цветом
local function createSubToggleWithColor(parent, name, default, colorCallback, toggleCallback)
    local frame = Instance.new("Frame")
    frame.Parent = parent
    frame.Size = UDim2.new(1, 0, 0, 26)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
    frame.BorderSizePixel = 0
    
    local corner = Instance.new("UICorner")
    corner.Parent = frame
    corner.CornerRadius = UDim.new(0, 4)
    
    local label = Instance.new("TextLabel")
    label.Parent = frame
    label.Size = UDim2.new(0.45, 0, 1, 0)
    label.Position = UDim2.new(0, 15, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Color3.fromRGB(200, 200, 210)
    label.Font = Enum.Font.Gotham
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    
    local btn = Instance.new("TextButton")
    btn.Parent = frame
    btn.Size = UDim2.new(0, 38, 0, 18)
    btn.Position = UDim2.new(0.5, 0, 0.5, -9)
    btn.BackgroundColor3 = default and Color3.fromRGB(70, 200, 70) or Color3.fromRGB(50, 50, 60)
    btn.Text = default and "ON" or "OFF"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 9
    btn.BorderSizePixel = 0
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.Parent = btn
    btnCorner.CornerRadius = UDim.new(0, 3)
    
    -- КНОПКА ВЫБОРА ЦВЕТА
    local colorBtn = Instance.new("ImageButton")
    colorBtn.Parent = frame
    colorBtn.Size = UDim2.new(0, 20, 0, 20)
    colorBtn.Position = UDim2.new(0.75, 0, 0.5, -10)
    colorBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    colorBtn.BorderSizePixel = 0
    
    local colorCorner = Instance.new("UICorner")
    colorCorner.Parent = colorBtn
    colorCorner.CornerRadius = UDim.new(0, 3)
    
    local state = default
    local currentColor = Color3.fromRGB(255, 255, 255)
    local colorIndex = 1
    
    local colors = {
        Color3.fromRGB(255, 0, 0),      -- Красный
        Color3.fromRGB(0, 255, 0),      -- Зеленый
        Color3.fromRGB(0, 0, 255),      -- Синий
        Color3.fromRGB(255, 255, 0),    -- Желтый
        Color3.fromRGB(255, 0, 255),    -- Розовый
        Color3.fromRGB(0, 255, 255),    -- Голубой
        Color3.fromRGB(255, 255, 255),  -- Белый
        Color3.fromRGB(255, 127, 0),    -- Оранжевый
    }
    
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.BackgroundColor3 = state and Color3.fromRGB(70, 200, 70) or Color3.fromRGB(50, 50, 60)
        btn.Text = state and "ON" or "OFF"
        if toggleCallback then toggleCallback(state) end
    end)
    
    colorBtn.MouseButton1Click:Connect(function()
        colorIndex = colorIndex % #colors + 1
        currentColor = colors[colorIndex]
        colorBtn.BackgroundColor3 = currentColor
        if colorCallback then colorCallback(currentColor) end
    end)
    
    return frame
end

