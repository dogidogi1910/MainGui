-- BIG HEADS
local function enableBigHeads()
    local HEAD_SIZE = 1.8
    
    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= player and v.Character then
            local char = v.Character
            local head = char:FindFirstChild("Head")
            if head then
                if not head:GetAttribute("OriginalSize") then
                    head:SetAttribute("OriginalSize", head.Size)
                end
                if not head:GetAttribute("OriginalMeshScale") then
                    local mesh = head:FindFirstChildOfClass("SpecialMesh")
                    if mesh then
                        head:SetAttribute("OriginalMeshScale", mesh.Scale)
                    end
                end
                
                local origSize = head:GetAttribute("OriginalSize") or Vector3.new(1, 1, 1)
                head.Size = origSize * HEAD_SIZE
                head.CanCollide = false
                
                local mesh = head:FindFirstChildOfClass("SpecialMesh")
                if mesh then
                    local origScale = head:GetAttribute("OriginalMeshScale") or Vector3.new(1, 1, 1)
                    mesh.Scale = origScale * HEAD_SIZE
                end
            end
        end
    end
end

local function disableBigHeads()
    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= player and v.Character then
            local char = v.Character
            local head = char:FindFirstChild("Head")
            if head then
                local origSize = head:GetAttribute("OriginalSize")
                if origSize then
                    head.Size = origSize
                end
                head.CanCollide = true
                
                local mesh = head:FindFirstChildOfClass("SpecialMesh")
                if mesh then
                    local origScale = head:GetAttribute("OriginalMeshScale")
                    if origScale then
                        mesh.Scale = origScale
                    end
                end
            end
        end
    end
end

RunService.Heartbeat:Connect(function()
    if _G.COMBAT.bigHeads then
        enableBigHeads()
    else
        disableBigHeads()
    end
end)

