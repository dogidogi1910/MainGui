local function applyESP(part)
    if part.Name == "Head" and part:IsA("BasePart") then
        local char = part.Parent
        if not char:FindFirstChildOfClass("Humanoid") then return end
        if char == player.Character then return end
        
        if espData[char] then
            espData[char]:Destroy()
            espData[char] = nil
        end
        
        if espDrawings[char] then
            if espDrawings[char].box then
                espDrawings[char].box:Remove()
            end
            espDrawings[char] = nil
        end
        
        local isSleeper = char.Name:lower():find("sleeper") or char:FindFirstChild("Sleeper")
        
        local bgui = Instance.new("BillboardGui")
        bgui.Parent = part
        bgui.AlwaysOnTop = true
        bgui.Size = UDim2.new(0, 200, 0, 80)
        bgui.Adornee = part
        
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Parent = bgui
        nameLabel.Size = UDim2.new(1, 0, 0, 20)
        nameLabel.Position = UDim2.new(0, 0, 0, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.TextColor3 = Color3.new(1, 1, 1)
        nameLabel.TextStrokeTransparency = 0.5
        nameLabel.TextSize = 14
        nameLabel.Font = Enum.Font.GothamSemibold
        nameLabel.TextXAlignment = Enum.TextXAlignment.Center
        nameLabel.TextYAlignment = Enum.TextYAlignment.Top
        nameLabel.Visible = false
        
        local healthLabel = Instance.new("TextLabel")
        healthLabel.Parent = bgui
        healthLabel.Size = UDim2.new(1, 0, 0, 20)
        healthLabel.Position = UDim2.new(0, 0, 0, 20)
        healthLabel.BackgroundTransparency = 1
        healthLabel.TextColor3 = Color3.new(1, 1, 1)
        healthLabel.TextStrokeTransparency = 0.5
        healthLabel.TextSize = 12
        healthLabel.Font = Enum.Font.GothamSemibold
        healthLabel.TextXAlignment = Enum.TextXAlignment.Center
        healthLabel.TextYAlignment = Enum.TextYAlignment.Top
        healthLabel.Visible = false
        
        local distLabel = Instance.new("TextLabel")
        distLabel.Parent = bgui
        distLabel.Size = UDim2.new(1, 0, 0, 20)
        distLabel.Position = UDim2.new(0, 0, 1, -20)
        distLabel.BackgroundTransparency = 1
        distLabel.TextColor3 = Color3.new(1, 1, 1)
        distLabel.TextStrokeTransparency = 0.5
        distLabel.TextSize = 12
        distLabel.Font = Enum.Font.GothamSemibold
        distLabel.TextXAlignment = Enum.TextXAlignment.Center
        distLabel.TextYAlignment = Enum.TextYAlignment.Center
        distLabel.Visible = false
        
        local highlight = Instance.new("Highlight")
        highlight.Parent = char
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0.2
        
        espData[char] = {bgui = bgui, highlight = highlight}
        
        local box = Drawing.new("Square")
        box.Thickness = 2
        box.Filled = false
        box.Transparency = 1
        box.Visible = false
        espDrawings[char] = {box = box}
        
        local connection
        connection = RunService.Heartbeat:Connect(function()
            if not char.Parent then
                bgui:Destroy()
                highlight:Destroy()
                if espDrawings[char] and espDrawings[char].box then
                    espDrawings[char].box:Remove()
                end
                espDrawings[char] = nil
                espData[char] = nil
                connection:Disconnect()
                return
            end
            
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            if not hrp or not head then return end
            
            local dist = math.floor((hrp.Position - Camera.CFrame.Position).Magnitude)
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hp = hum and math.floor(hum.Health) or 0
            local maxHp = hum and math.floor(hum.MaxHealth) or 0
            
            local show = false
            
            if _G.ESP.enabled then
                if isSleeper and _G.ESP.sleepers then
                    show = true
                    nameLabel.Text = "SLEEPER"
                    nameLabel.TextColor3 = _G.ESP.nameColor or Color3.fromRGB(150, 150, 150)
                    highlight.FillColor = Color3.fromRGB(150, 150, 150)
                    highlight.OutlineColor = Color3.fromRGB(100, 100, 100)
                elseif not isSleeper then
                    show = true
                    nameLabel.Text = char.Name
                    nameLabel.TextColor3 = _G.ESP.nameColor or Color3.fromRGB(255, 255, 255)
                    highlight.FillColor = _G.ESP.chamsColor or Color3.fromRGB(255, 85, 85)
                    highlight.OutlineColor = _G.ESP.chamsColor or Color3.fromRGB(200, 50, 50)
                end
            end
            
            bgui.Enabled = show
            highlight.Enabled = show and _G.ESP.chams
            
            nameLabel.Visible = show and _G.ESP.name
            
            if show and _G.ESP.health then
                healthLabel.Visible = true
                healthLabel.Text = "[HP: " .. hp .. "/" .. maxHp .. "]"
                healthLabel.TextColor3 = _G.ESP.healthColor or Color3.fromRGB(255, 255, 255)
            else
                healthLabel.Visible = false
            end
            
            if show and _G.ESP.box then
                local bottomPos, bottomOnScreen = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 2.5, 0))
                local topPos, topOnScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
                
                if bottomOnScreen and topOnScreen then
                    local height = bottomPos.Y - topPos.Y
                    local width = height * 0.5
                    local box = espDrawings[char].box
                    box.Visible = true
                    box.Color = _G.ESP.boxColor or Color3.fromRGB(255, 255, 255)
                    box.Size = Vector2.new(width, height)
                    box.Position = Vector2.new(topPos.X - width/2, topPos.Y)
                else
                    espDrawings[char].box.Visible = false
                end
            else
                if espDrawings[char] and espDrawings[char].box then
                    espDrawings[char].box.Visible = false
                end
            end
            
            if show and _G.ESP.distance then
                distLabel.Visible = true
                distLabel.Text = dist .. "m"
                distLabel.TextColor3 = _G.ESP.distanceColor or Color3.fromRGB(255, 255, 255)
            else
                distLabel.Visible = false
            end
        end)
    end
end

