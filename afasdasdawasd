local ReloadFunction = nil
local ReloadHook = nil

local function setupInstantReload()
    for i, v in pairs(getgc(true)) do
        if type(v) == "function" then
            local info = debug.getinfo(v)
            if info and info.name == "Reload" then
                local src = info.short_src or ""
                if src:find("DefaultGun") then
                    ReloadFunction = v
                    print("✅ Instant Reload: найдена функция Reload")
                    return true
                end
            end
        end
    end
    warn("⚠️ Instant Reload: функция не найдена")
    return false
end

local function enableInstantReload()
    if not ReloadFunction then
        if not setupInstantReload() then return false end
    end
    if not ReloadHook then
        ReloadHook = hookfunction(ReloadFunction, function(self, time)
            if _G.COMBAT.instantReload then
                return ReloadFunction(self, 0)
            end
            return ReloadFunction(self, time)
        end)
    end
    print("✅ Instant Reload: включен")
    return true
end

local function disableInstantReload()
    if ReloadHook and ReloadFunction then
        hookfunction(ReloadFunction, ReloadHook)
        ReloadHook = nil
    end
    print("❌ Instant Reload: выключен")
end

setupInstantReload()
task.delay(5, function()
    if not ReloadFunction then setupInstantReload() end
end)

