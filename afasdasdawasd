local dragging = false
local dragStart = nil
local frameStart = nil

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        frameStart = mainFrame.Position
    end
end)

mainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end

    local offset = input.Position - dragStart
    mainFrame.Position = UDim2.new(
        frameStart.X.Scale,
        frameStart.X.Offset + offset.X,
        frameStart.Y.Scale,
        frameStart.Y.Offset + offset.Y
    )
end)

-- ===== 3. ESP ДЛЯ LONE SURVIVAL (РАБОЧИЙ) =====
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera
local Drawing = Drawing or nil

if not Drawing then
    warn("Drawing не поддерживается!")
end

local espObjects = {}

-- Функция поиска игроков в workspace (по частям тела)
local function findPlayersInWorkspace()
    local found = {}
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") then
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            if hrp and obj ~= player.Character then
                table.insert(found, obj)
            end
        end
    end
    return found
end

local function createEspForModel(model)
    if espObjects[model] or not Drawing then return end
    
    -- Бокс
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = _G.ESP.boxColor or Color3.new(1, 1, 1)
    box.Thickness = 1.5
    box.Transparency = 1
    box.Filled = false
    
    -- Имя
    local nameText = Drawing.new("Text")
    nameText.Visible = false
    nameText.Color = _G.ESP.nameColor or Color3.new(1, 1, 1)
    nameText.Size = 14
    nameText.Center = true
    nameText.Outline = true
    nameText.OutlineColor = Color3.new(0, 0, 0)
    nameText.Font = 2
    
    -- Дистанция
    local distText = Drawing.new("Text")
    distText.Visible = false
    distText.Color = _G.ESP.distanceColor or Color3.new(1, 1, 1)
    distText.Size = 12
    distText.Center = true
    distText.Outline = true
    distText.OutlineColor = Color3.new(0, 0, 0)
    distText.Font = 2
    
    -- ХП бар
    local healthBar = Drawing.new("Square")
    healthBar.Visible = false
    healthBar.Color = Color3.new(1, 0, 0)
    healthBar.Thickness = 0
    healthBar.Transparency = 0.8
    healthBar.Filled = true
    
    local healthOutline = Drawing.new("Square")
    healthOutline.Visible = false
    healthOutline.Color = Color3.new(0, 0, 0)
    healthOutline.Thickness = 1
    healthOutline.Transparency = 1
    healthOutline.Filled = false
    
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not _G.ESP.enabled or not model or not model.Parent then
            box.Visible = false
            nameText.Visible = false
            distText.Visible = false
            healthBar.Visible = false
            healthOutline.Visible = false
            return
        end
        
        local hrp = model:FindFirstChild("HumanoidRootPart")
        if not hrp then
            box.Visible = false
            nameText.Visible = false
            distText.Visible = false
            healthBar.Visible = false
            healthOutline.Visible = false
            return
        end
        
        local humanoid = model:FindFirstChild("Humanoid")
        if not humanoid then
            for _, child in ipairs(model:GetChildren()) do
                if child:IsA("Humanoid") then
                    humanoid = child
                    break
                end
            end
        end
        
        local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if not onScreen then
            box.Visible = false
            nameText.Visible = false
            distText.Visible = false
            healthBar.Visible = false
            healthOutline.Visible = false
            return
        end
        
        -- Расчёт размеров
        local sizeY = 4
        local sizeX = 2
        
        local head = model:FindFirstChild("Head")
        if head and head:IsA("BasePart") then
            local headPos, headOn = Camera:WorldToViewportPoint(head.Position)
            if headOn then
                sizeY = math.abs(headPos.Y - pos.Y) * 1.5
            end
        end
        
        if sizeY < 2 then
            local dist = (hrp.Position - Camera.CFrame.Position).Magnitude
            sizeY = math.clamp(200 / dist, 1.5, 10)
            sizeX = sizeY * 0.6
        else
            sizeX = sizeY * 0.6
        end
        
        -- БОКС
        if _G.ESP.box then
            box.Size = Vector2.new(sizeX, sizeY)
            box.Position = Vector2.new(pos.X - sizeX / 2, pos.Y - sizeY / 2)
            box.Color = _G.ESP.boxColor or Color3.new(1, 1, 1)
            box.Visible = true
        else
            box.Visible = false
        end
        
        -- ИМЯ
        if _G.ESP.name then
            local displayName = model.Name
            for _, v in ipairs(Players:GetPlayers()) do
                if v.Character == model then
                    displayName = v.Name
                    break
                end
            end
            nameText.Text = displayName
            nameText.Position = Vector2.new(pos.X, pos.Y - sizeY / 2 - 16)
            nameText.Color = _G.ESP.nameColor or Color3.new(1, 1, 1)
            nameText.Visible = true
        else
            nameText.Visible = false
        end
        
        -- ДИСТАНЦИЯ
        if _G.ESP.distance and player.Character then
            local playerHrp = player.Character:FindFirstChild("HumanoidRootPart")
            if playerHrp then
                local dist = (hrp.Position - playerHrp.Position).Magnitude
                distText.Text = string.format("%.0fm", dist)
                distText.Position = Vector2.new(pos.X, pos.Y + sizeY / 2 + 16)
                distText.Color = _G.ESP.distanceColor or Color3.new(1, 1, 1)
                distText.Visible = true
            end
        else
            distText.Visible = false
        end
        
        -- ХП БАР
        if _G.ESP.healthbar and humanoid then
            local health = humanoid.Health / humanoid.MaxHealth
            if health < 0 then health = 0 end
            
            local barWidth = 6
            local barHeight = sizeY
            
            local barX = pos.X + sizeX / 2 + 4
            local barY = pos.Y - sizeY / 2
            
            healthOutline.Size = Vector2.new(barWidth + 2, barHeight + 2)
            healthOutline.Position = Vector2.new(barX - 1, barY - 1)
            healthOutline.Visible = true
            
            healthBar.Size = Vector2.new(barWidth, barHeight * health)
            healthBar.Position = Vector2.new(barX, barY + barHeight * (1 - health))
            healthBar.Color = Color3.new(1 - health, health, 0)
            healthBar.Visible = true
        else
            healthBar.Visible = false
            healthOutline.Visible = false
        end
    end)
    
    espObjects[model] = {
        box = box,
        name = nameText,
        distance = distText,
        healthBar = healthBar,
        healthOutline = healthOutline,
        connection = connection,
        model = model
    }
end

local function cleanupEsp(model)
    if espObjects[model] then
        local obj = espObjects[model]
        pcall(function()
            obj.box:Remove()
            obj.name:Remove()
            obj.distance:Remove()
            obj.healthBar:Remove()
            obj.healthOutline:Remove()
        end)
        if obj.connection then
            obj.connection:Disconnect()
        end
        espObjects[model] = nil
    end
end

local function scanForPlayers()
    if not Drawing then return end
    local models = findPlayersInWorkspace()
    for _, model in ipairs(models) do
        if not espObjects[model] then
            createEspForModel(model)
        end
    end
    
    for model, _ in pairs(espObjects) do
        if not model or not model.Parent then
            cleanupEsp(model)
        end
    end
end

task.spawn(function()
    while task.wait(2) do
        if _G.ESP.enabled then
            scanForPlayers()
        end
    end
end)

Players.PlayerRemoving:Connect(function(v)
    if v.Character then
        cleanupEsp(v.Character)
    end
end)

