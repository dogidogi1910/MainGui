local espObjects = {}

local function createEspForPlayer(model)
    if espObjects[model] then return end
    
    -- Бокс
    local box = Instance.new("Frame")
    box.Parent = screenGui
    box.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    box.BackgroundTransparency = 0.75
    box.BorderSizePixel = 1
    box.BorderColor3 = Color3.fromRGB(255, 255, 255)
    box.Visible = false
    
    -- Имя
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Parent = screenGui
    nameLabel.Size = UDim2.new(0, 200, 0, 20)
    nameLabel.AnchorPoint = Vector2.new(0.5, 0.5)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 13
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    nameLabel.Visible = false
    
    -- Дистанция
    local distLabel = Instance.new("TextLabel")
    distLabel.Parent = screenGui
    distLabel.Size = UDim2.new(0, 100, 0, 20)
    distLabel.AnchorPoint = Vector2.new(0.5, 0.5)
    distLabel.BackgroundTransparency = 1
    distLabel.TextColor3 = Color3.fromRGB(121, 7, 252)
    distLabel.Font = Enum.Font.Gotham
    distLabel.TextSize = 12
    distLabel.TextStrokeTransparency = 0
    distLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    distLabel.Visible = false
    
    -- ХП бар
    local healthBar = Instance.new("Frame")
    healthBar.Parent = screenGui
    healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    healthBar.BackgroundTransparency = 0
    healthBar.BorderSizePixel = 0
    healthBar.Visible = false
    
    local healthBg = Instance.new("Frame")
    healthBg.Parent = screenGui
    healthBg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    healthBg.BackgroundTransparency = 0.3
    healthBg.BorderSizePixel = 0
    healthBg.Visible = false
    
    local function hideAll()
        box.Visible = false
        nameLabel.Visible = false
        distLabel.Visible = false
        healthBar.Visible = false
        healthBg.Visible = false
    end
    
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not _G.ESP.Enabled then
            hideAll()
            return
        end
        
        if not model or not model.Parent then
            hideAll()
            return
        end
        
        local hrp = model:FindFirstChild("HumanoidRootPart")
        local humanoid = model:FindFirstChild("Humanoid")
        if not hrp or not humanoid then
            hideAll()
            return
        end
        
        local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if not onScreen then
            hideAll()
            return
        end
        
        local dist = (hrp.Position - Camera.CFrame.Position).Magnitude / 3.5714285714
        if dist > _G.ESP.MaxDistance then
            hideAll()
            return
        end
        
        -- Размеры
        local sizeY = 4
        local head = model:FindFirstChild("Head")
        if head and head:IsA("BasePart") then
            local headPos = Camera:WorldToViewportPoint(head.Position)
            sizeY = math.abs(headPos.Y - pos.Y) * 1.5
        end
        
        if sizeY < 2 then
            sizeY = math.clamp(200 / dist, 1.5, 10)
        end
        local sizeX = sizeY * 0.6
        
        -- БОКС
        if _G.ESP.box then
            box.Size = UDim2.new(0, sizeX, 0, sizeY)
            box.Position = UDim2.new(0, pos.X - sizeX / 2, 0, pos.Y - sizeY / 2)
            box.Visible = true
        else
            box.Visible = false
        end
        
        -- ИМЯ
        if _G.ESP.name then
            nameLabel.Text = model.Name
            nameLabel.Position = UDim2.new(0, pos.X, 0, pos.Y - sizeY / 2 - 16)
            nameLabel.Visible = true
        else
            nameLabel.Visible = false
        end
        
        -- ДИСТАНЦИЯ
        if _G.ESP.distance then
            distLabel.Text = string.format("%.0fm", dist)
            distLabel.Position = UDim2.new(0, pos.X, 0, pos.Y + sizeY / 2 + 16)
            distLabel.Visible = true
        else
            distLabel.Visible = false
        end
        
        -- ХП БАР
        if _G.ESP.healthbar then
            local health = humanoid.Health / humanoid.MaxHealth
            if health < 0 then health = 0
            
            local barWidth = 2.5
            local barHeight = sizeY
            
            healthBg.Size = UDim2.new(0, barWidth + 2, 0, barHeight + 2)
            healthBg.Position = UDim2.new(0, pos.X - sizeX / 2 - 6 - 1, 0, pos.Y - sizeY / 2 - 1)
            healthBg.Visible = true
            
            healthBar.Size = UDim2.new(0, barWidth, 0, barHeight * health)
            healthBar.Position = UDim2.new(0, pos.X - sizeX / 2 - 6, 0, pos.Y + sizeY / 2 - barHeight * health)
            healthBar.BackgroundColor3 = Color3.new(1 - health, health, 0)
            healthBar.Visible = true
        else
            healthBar.Visible = false
            healthBg.Visible = false
        end
    end)
    
    model.AncestryChanged:Connect(function(_, parent)
        if not parent then
            box:Destroy()
            nameLabel:Destroy()
            distLabel:Destroy()
            healthBar:Destroy()
            healthBg:Destroy()
            connection:Disconnect()
            espObjects[model] = nil
        end
    end)
    
    espObjects[model] = {
        box = box,
        name = nameLabel,
        distance = distLabel,
        healthBar = healthBar,
        healthBg = healthBg,
        connection = connection
    }
end

-- ===== 4. СКАНИРОВАНИЕ =====
local function scanForPlayers()
    local models = findPlayersInWorkspace()
    for _, model in ipairs(models) do
        if not espObjects[model] then
            createEspForPlayer(model)
        end
    end
    
    for model, _ in pairs(espObjects) do
        if not model or not model.Parent then
            if espObjects[model] and espObjects[model].connection then
                espObjects[model].connection:Disconnect()
            end
            espObjects[model] = nil
        end
    end
end

task.spawn(function()
    while task.wait(2) do
        if _G.ESP.Enabled then
            scanForPlayers()
        end
    end
end)

