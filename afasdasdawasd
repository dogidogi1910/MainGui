-- Snaplines
RunService.RenderStepped:Connect(function()
    if _G.COMBAT.snaplines then
        local fovRadius = _G.COMBAT.fov or 120
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        
        local closestPlayer = nil
        local closestDist = math.huge
        
        for _, v in ipairs(getPlayers()) do
            local hrp = v.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    
                    local inFov = true
                    if _G.COMBAT.fovEnabled then
                        inFov = dist < fovRadius
                    end
                    
                    if inFov and dist < closestDist then
                        closestDist = dist
                        closestPlayer = v
                    end
                end
            end
        end
        
        for _, line in pairs(snaplinesDrawings) do
            line.Visible = false
        end
        
        if closestPlayer then
            local hrp = closestPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    if not snaplinesDrawings[closestPlayer] then
                        snaplinesDrawings[closestPlayer] = Drawing.new("Line")
                        snaplinesDrawings[closestPlayer].Thickness = 1.5
                        snaplinesDrawings[closestPlayer].Color = Color3.fromRGB(255, 255, 255)
                        snaplinesDrawings[closestPlayer].Transparency = 1
                    end
                    local line = snaplinesDrawings[closestPlayer]
                    line.Visible = true
                    line.From = center
                    line.To = Vector2.new(pos.X, pos.Y)
                end
            end
        end
    else
        for _, line in pairs(snaplinesDrawings) do
            line.Visible = false
        end
    end
end)

-- ===== AIMBOT + RAINBOW FOV =====
local hue = 0
RunService.RenderStepped:Connect(function(dt)
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    -- FOV (через GUI)
    if _G.COMBAT.fovEnabled then
        fovGUI.outer.Visible = true
        fovGUI.inner.Visible = true
        if _G.COMBAT.fovRainbow then
            hue = (hue + dt * 0.5) % 1
            fovGUI.stroke.Color = hsvToRgb(hue, 1, 1)
        else
            fovGUI.stroke.Color = Color3.fromRGB(255, 255, 255)
        end
    else
        fovGUI.outer.Visible = false
        fovGUI.inner.Visible = false
    end
    
    -- Aimbot (через камеру)
    if _G.COMBAT.aimbot then
        local validTarget = false
        if aimTarget and aimTarget.Parent then
            local humanoid = aimTarget.Parent:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local pos, visible = Camera:WorldToViewportPoint(aimTarget.Position)
                if visible then
                    local mag = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                    if mag <= fovRadius then
                        validTarget = true
                    end
                end
            end
        end
        
        if not validTarget then
            aimTarget = getClosestHead(screenCenter)
        end
        
        if aimTarget then
            local goalCFrame = CFrame.new(Camera.CFrame.Position, aimTarget.Position)
            local smooth = _G.COMBAT.aimSmooth or 5
            local lerpFactor = math.clamp(1 - (smooth / 20), 0.5, 0.99)
            Camera.CFrame = Camera.CFrame:Lerp(goalCFrame, lerpFactor)
        end
    end
end)

